  "info": {
    "_postman_id": "85895043-6055-41ed-bf38-6556efda2298",
    "name": "EODHD End-Of-Day Historical Data Eod API",
    "description": "Access end-of-day historical OHLCV data for stocks, ETFs, funds, indices, and currencies across global exchanges. Returns daily, weekly, or monthly historical price and volume data with both raw and split/dividend-adjusted closing prices.\n\nContact Support:\n Name: EODHD Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:34:27.000Z",
    "updatedAt": "2026-07-28T01:34:28.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-85895043-6055-41ed-bf38-6556efda2298"
  },
