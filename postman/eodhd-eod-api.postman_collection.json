          "item": [
            {
              "name": "Retrieve end-of-day historical data",
              "id": "3f0003c0-8cc2-4617-a55b-877e7b91ef41",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/eod/:symbol?api_token=<string>&fmt=csv&period=d&order=a&from=<date>&to=<date>&filter=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "eod",
                    ":symbol"
                  ],
                  "query": [
                    {
                      "description": "(Required) API token assigned to your EODHD account.",
                      "key": "api_token",
                      "value": "<string>"
                    },
                    {
                      "description": "Response format. Defaults to csv.",
                      "key": "fmt",
                      "value": "csv"
                    },
                    {
                      "description": "Aggregation period. d=daily, w=weekly, m=monthly.",
                      "key": "period",
                      "value": "d"
                    },
                    {
                      "description": "Sort order of returned rows. a=ascending, d=descending.",
                      "key": "order",
                      "value": "a"
                    },
                    {
                      "description": "Inclusive start date in YYYY-MM-DD format.",
                      "key": "from",
                      "value": "<date>"
                    },
                    {
                      "description": "Inclusive end date in YYYY-MM-DD format.",
                      "key": "to",
                      "value": "<date>"
                    },
                    {
                      "description": "Return only a single field, e.g. last_close or last_volume.",
                      "key": "filter",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "fe42860d-630f-4e14-81bd-a45c0639ec9d",
                      "key": "symbol",
                      "value": "<string>",
                      "description": "(Required) Ticker symbol with exchange suffix, e.g. AAPL.US."
                    }
                  ]
                },
                "description": "Returns the end-of-day historical OHLCV time series for a given ticker symbol. The symbol must include the exchange suffix, for example AAPL.US or BMW.XETRA. One call per request regardless of date range."
